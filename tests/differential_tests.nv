// differential_tests.nv — seeded sitemaps this package writes, as
// Python's xml.etree.ElementTree read them.
//
// Written by tools/differential.py; do not edit by hand.  Seed 20260927,
// 30 URL sets and 10 indexes.  ElementTree read every value back from
// each document below before it was written here.  The writer must
// produce the same text again, and both readers must read it back to
// the same number of entries with nothing skipped.

use std.test
use std.list
use std.bytes
use sitemapdoc
use sitemapread
use sitemapurl
use sitemapwrite

fn text_of(r: Result<[u8], SitemapFault>) -> Str
    match r
        Ok(b)  => bytes.byte_list_to_str(list.map(b, int_of))
        Err(f) => f.message()

fn int_of(b: u8) -> Int
    b as Int

@test
fn test_case_00() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset>\n  <url>\n    <loc>http://www.example.com/xcc96</loc>\n    <changefreq>weekly</changefreq>\n  </url>\n</urlset>\n"
    test.assert_eq(text_of(sitemapwrite.write_urlset([],
        sitemapurl.urlset([sitemapurl.with_changefreq(sitemapurl.url("http://www.example.com/xcc96"), SitemapWeekly)]),
        sitemapwrite.without_namespace(sitemapwrite.options()))),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 1)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_01() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url>\n    <loc>https://www.example.com/</loc>\n    <lastmod>2004-12-23T18:00+00:00</lastmod>\n    <changefreq>daily</changefreq>\n  </url>\n  <url>\n    <loc>https://shop.example.net:8080/-?q=1</loc>\n    <lastmod>2005-01-01</lastmod>\n    <changefreq>daily</changefreq>\n    <priority>1.0</priority>\n  </url>\n</urlset>\n"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/"), "2004-12-23T18:00+00:00"),
        SitemapDaily),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/-?q=1"), "2005-01-01"),
        SitemapDaily),
    1000)]),
    sitemapwrite.options())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 2)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_02() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <url>\n    <loc>https://example.org/</loc>\n    <lastmod>2004-12-23T18:00:15+00:00</lastmod>\n    <priority>0.0</priority>\n  </url>\n  <url>\n    <loc>https://shop.example.net:8080/az9y/</loc>\n    <lastmod>2005</lastmod>\n    <changefreq>always</changefreq>\n  </url>\n  <url>\n    <loc>https://example.org/.-</loc>\n    <changefreq>never</changefreq>\n    <priority>1.0</priority>\n  </url>\n</urlset>\n"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_lastmod(sitemapurl.url("https://example.org/"), "2004-12-23T18:00:15+00:00"),
        0),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/az9y/"), "2005"),
        SitemapAlways),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.url("https://example.org/.-"), SitemapNever), 1000)]),
    sitemapwrite.options())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 3)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_03() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset>\n  <url>\n    <loc>http://www.example.com/0</loc>\n    <lastmod>1999-12-31T23:59:59-05:30</lastmod>\n    <changefreq>always</changefreq>\n    <priority>0.5</priority>\n  </url>\n  <url>\n    <loc>http://example.org/9~9</loc>\n    <lastmod>2005-01</lastmod>\n    <changefreq>hourly</changefreq>\n    <priority>0.5</priority>\n  </url>\n  <url>\n    <loc>https://shop.example.net:8080/ c</loc>\n    <lastmod>2004-12-23T18:00+00:00</lastmod>\n    <changefreq>never</changefreq>\n    <priority>0.0</priority>\n  </url>\n  <url>\n    <loc>https://shop.example.net:8080/c9&gt;?q=1éa#top</loc>\n    <lastmod>2004-12-23T18:00:15+00:00</lastmod>\n    <changefreq>never</changefreq>\n    <priority>0.0</priority>\n  </url>\n  <url>\n    <loc>https://www.example.com/%C3%BC&apos;_%C3%BC#top&apos;</loc>\n    <lastmod>2004-12-23T18:00:15+00:00</lastmod>\n    <changefreq>hourly</changefreq>\n  </url>\n</urlset>\n"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://www.example.com/0"), "1999-12-31T23:59:59-05:30"),
        SitemapAlways),
    500),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://example.org/9~9"), "2005-01"), SitemapHourly),
        500),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/ c"), "2004-12-23T18:00+00:00"),
        SitemapNever),
    0),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/c9>?q=1éa#top"), "2004-12-23T18:00:15+00:00"),
        SitemapNever),
    0),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/%C3%BC'_%C3%BC#top'"), "2004-12-23T18:00:15+00:00"),
        SitemapHourly)]),
    sitemapwrite.without_namespace(sitemapwrite.options()))),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 5)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_04() [io]
    let text = "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://www.example.com/yc5.~/%C3%BC</loc><lastmod>2005-01-01</lastmod><changefreq>yearly</changefreq><priority>1.0</priority></url><url><loc>http://shop.example.net:8080/&lt;6~&apos;8&apos;8_</loc><lastmod>2005-01-01</lastmod><changefreq>yearly</changefreq></url><url><loc>https://www.example.com/&lt;&amp;8</loc><lastmod>2004-12-23T18:00:15+00:00</lastmod><changefreq>weekly</changefreq><priority>0.5</priority></url><url><loc>https://www.example.com/a9.#top</loc><lastmod>1999-12-31T23:59:59-05:30</lastmod><changefreq>hourly</changefreq><priority>0.578</priority></url><url><loc>https://www.example.com/#top#top&gt;_z</loc><lastmod>1999-12-31T23:59:59-05:30</lastmod><changefreq>monthly</changefreq></url></urlset>"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/yc5.~/%C3%BC"), "2005-01-01"),
        SitemapYearly),
    1000),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://shop.example.net:8080/<6~'8'8_"), "2005-01-01"),
        SitemapYearly),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/<&8"), "2004-12-23T18:00:15+00:00"),
        SitemapWeekly),
    500),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/a9.#top"), "1999-12-31T23:59:59-05:30"),
        SitemapHourly),
    578),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/#top#top>_z"), "1999-12-31T23:59:59-05:30"),
        SitemapMonthly)]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 5)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_05() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n   <url>\n      <loc>https://example.org/é&amp;</loc>\n      <changefreq>daily</changefreq>\n   </url>\n   <url>\n      <loc>https://shop.example.net:8080/5_68z-x29&amp;é/</loc>\n      <lastmod>1999-12-31T23:59:59-05:30</lastmod>\n      <changefreq>daily</changefreq>\n   </url>\n   <url>\n      <loc>http://www.example.com/bxc8~#top</loc>\n      <lastmod>2005-01</lastmod>\n      <changefreq>weekly</changefreq>\n      <priority>1.0</priority>\n   </url>\n   <url>\n      <loc>https://example.org/63_-9x</loc>\n      <changefreq>never</changefreq>\n      <priority>0.08</priority>\n   </url>\n   <url>\n      <loc>https://shop.example.net:8080/</loc>\n      <lastmod>2005</lastmod>\n      <changefreq>hourly</changefreq>\n      <priority>0.0</priority>\n   </url>\n   <url>\n      <loc>http://example.org/5#topy&apos;</loc>\n      <lastmod>2026-09-27T09:41:00.5Z</lastmod>\n      <changefreq>never</changefreq>\n      <priority>0.5</priority>\n   </url>\n</urlset>\n"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_changefreq(sitemapurl.url("https://example.org/é&"), SitemapDaily), sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/5_68z-x29&é/"), "1999-12-31T23:59:59-05:30"),
        SitemapDaily),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://www.example.com/bxc8~#top"), "2005-01"),
        SitemapWeekly),
    1000),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.url("https://example.org/63_-9x"), SitemapNever), 80), sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/"), "2005"),
        SitemapHourly),
    0),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://example.org/5#topy'"), "2026-09-27T09:41:00.5Z"),
        SitemapNever),
    500)]),
    SitemapWriteOptions { indent: 3, declaration: true, namespace: true })),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 6)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

