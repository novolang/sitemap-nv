@test
fn test_case_09() [io]
    let text = "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>http://example.org/_#topz #topc~1</loc><lastmod>2005</lastmod><changefreq>monthly</changefreq><priority>1.0</priority></url><url><loc>http://www.example.com/?q=1é/4</loc><changefreq>never</changefreq><priority>1.0</priority></url><url><loc>http://www.example.com/z&apos;5%C3%BC3&apos;0&amp;4</loc><lastmod>2005-01</lastmod><changefreq>daily</changefreq></url><url><loc>http://www.example.com/x.éa0&gt;~_&lt;&lt;</loc><lastmod>2005-01</lastmod><changefreq>daily</changefreq><priority>0.5</priority></url><url><loc>http://www.example.com/</loc><lastmod>2005-01</lastmod><changefreq>hourly</changefreq><priority>0.516</priority></url></urlset>"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://example.org/_#topz #topc~1"), "2005"),
        SitemapMonthly),
    1000),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.url("http://www.example.com/?q=1é/4"), SitemapNever),
        1000),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://www.example.com/z'5%C3%BC3'0&4"), "2005-01"),
        SitemapDaily),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://www.example.com/x.éa0>~_<<"), "2005-01"),
        SitemapDaily),
    500),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://www.example.com/"), "2005-01"), SitemapHourly),
        516)]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 5)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

