        SitemapWeekly),
    0),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://example.org/y\"z%C3%BC>8~>yb"), "2004-12-23T18:00:15+00:00"),
        SitemapMonthly),
