@test
fn test_case_07() [io]
    let text = "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://www.example.com/</loc><lastmod>2005-01</lastmod><changefreq>never</changefreq><priority>0.963</priority></url><url><loc>http://shop.example.net:8080/?q=1</loc><lastmod>2005-01</lastmod></url><url><loc>https://example.org/9~z</loc><lastmod>1999-12-31T23:59:59-05:30</lastmod><changefreq>never</changefreq></url><url><loc>http://shop.example.net:8080/343a</loc><lastmod>1999-12-31T23:59:59-05:30</lastmod><changefreq>weekly</changefreq><priority>0.0</priority></url><url><loc>https://example.org/69?q=1b_by-7%C3%BC~&quot;</loc><lastmod>2005-01-01</lastmod><changefreq>hourly</changefreq><priority>1.0</priority></url></urlset>"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://www.example.com/"), "2005-01"), SitemapNever),
        963),
    sitemapurl.with_lastmod(sitemapurl.url("http://shop.example.net:8080/?q=1"), "2005-01"), sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://example.org/9~z"), "1999-12-31T23:59:59-05:30"),
        SitemapNever),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://shop.example.net:8080/343a"), "1999-12-31T23:59:59-05:30"),
        SitemapWeekly),
    0),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://example.org/69?q=1b_by-7%C3%BC~\""), "2005-01-01"),
        SitemapHourly),
    1000)]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 5)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

