        SitemapNever),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://shop.example.net:8080/4é?q=1c"), "2005"),
        SitemapAlways),
    1000),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://example.org/'>"), "2005-01-01"), SitemapAlways)]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 3)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
