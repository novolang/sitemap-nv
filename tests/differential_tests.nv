    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n   <sitemap>\n      <loc>https://www.example.com/&gt;?q=1&apos;&amp;~ .xml</loc>\n      <lastmod>2004-12-23T18:00+00:00</lastmod>\n   </sitemap>\n</sitemapindex>\n"
    test.assert_eq(text_of(sitemapwrite.write_index([],
        sitemapdoc.index([sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("https://www.example.com/>?q=1'&~ .xml"), "2004-12-23T18:00+00:00")]),
        SitemapWriteOptions { indent: 3, declaration: true, namespace: true })),
    text)
