    let text = "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>https://example.org/9zxxa%C3%BC</loc><lastmod>2005-01-01</lastmod><changefreq>hourly</changefreq><priority>1.0</priority></url><url><loc>http://example.org/éa1cx~98#top</loc><changefreq>monthly</changefreq><priority>1.0</priority></url><url><loc>http://example.org/1&gt;#top#top51#top c</loc><lastmod>2005-01-01</lastmod><changefreq>hourly</changefreq></url><url><loc>https://shop.example.net:8080/%C3%BC&apos;57cb</loc><lastmod>2026-09-27T09:41:00.5Z</lastmod><changefreq>always</changefreq><priority>0.5</priority></url></urlset>"
    test.assert_eq(text_of(sitemapwrite.write_urlset([], sitemapurl.urlset([sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://example.org/9zxxa%C3%BC"), "2005-01-01"),
        SitemapHourly),
    1000),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.url("http://example.org/éa1cx~98#top"), SitemapMonthly),
        1000),
    sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("http://example.org/1>#top#top51#top c"), "2005-01-01"),
        SitemapHourly),
    sitemapurl.with_priority(sitemapurl.with_changefreq(sitemapurl.with_lastmod(sitemapurl.url("https://shop.example.net:8080/%C3%BC'57cb"), "2026-09-27T09:41:00.5Z"),
        SitemapAlways),
    500)]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.urls.urls), 4)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "urlset")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

