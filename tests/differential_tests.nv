fn test_case_11() [io]
    let text = "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>http://shop.example.net:8080//&lt;2&gt;x</loc><lastmod>2004-12-23T18:00+00:00</lastmod><changefreq>never</changefreq></url><url><loc>http://shop.example.net:8080/4é?q=1c</loc><lastmod>2005</lastmod><changefreq>always</changefreq><priority>1.0</priority></url><url><loc>http://example.org/&apos;&gt;</loc><lastmod>2005-01-01</lastmod><changefreq>always</changefreq></url></urlset>"
