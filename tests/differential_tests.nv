fn test_case_36() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <sitemap>\n    <loc>http://shop.example.net:8080/0%C3%BC6 2&lt;_ &amp;.xml</loc>\n    <lastmod>2026-09-27T09:41:00.5Z</lastmod>\n  </sitemap>\n</sitemapindex>\n"
    test.assert_eq(text_of(sitemapwrite.write_index([], sitemapdoc.index([sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("http://shop.example.net:8080/0%C3%BC6 2<_ &.xml"),
        "2026-09-27T09:41:00.5Z")]),
    sitemapwrite.options())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.index.refs), 1)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "sitemapindex")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_37() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n  <sitemap>\n    <loc>https://www.example.com/5.xml</loc>\n    <lastmod>2026-09-27T09:41:00.5Z</lastmod>\n  </sitemap>\n</sitemapindex>\n"
    test.assert_eq(text_of(sitemapwrite.write_index([],
        sitemapdoc.index([sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("https://www.example.com/5.xml"), "2026-09-27T09:41:00.5Z")]),
        sitemapwrite.options())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.index.refs), 1)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "sitemapindex")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_38() [io]
    let text = "<sitemapindex xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><sitemap><loc>http://example.org/%C3%BC?q=1&amp;&gt;312c~.xml</loc><lastmod>2026-09-27T09:41:00.5Z</lastmod></sitemap><sitemap><loc>http://example.org/y.xml</loc><lastmod>2005</lastmod></sitemap></sitemapindex>"
    test.assert_eq(text_of(sitemapwrite.write_index([], sitemapdoc.index([sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("http://example.org/%C3%BC?q=1&>312c~.xml"), "2026-09-27T09:41:00.5Z"),
        sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("http://example.org/y.xml"), "2005")]),
    sitemapwrite.compact())),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.index.refs), 2)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "sitemapindex")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)

@test
fn test_case_39() [io]
    let text = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<sitemapindex>\n  <sitemap>\n    <loc>http://www.example.com/y%C3%BC7é6&lt;%C3%BCy-3.xml</loc>\n    <lastmod>2004-12-23T18:00+00:00</lastmod>\n  </sitemap>\n  <sitemap>\n    <loc>https://example.org/?q=151a3.xml</loc>\n    <lastmod>2026-09-27T09:41:00.5Z</lastmod>\n  </sitemap>\n  <sitemap>\n    <loc>http://www.example.com/60#top9&lt;/..xml</loc>\n  </sitemap>\n</sitemapindex>\n"
    test.assert_eq(text_of(sitemapwrite.write_index([], sitemapdoc.index([sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("http://www.example.com/y%C3%BC7é6<%C3%BCy-3.xml"),
        "2004-12-23T18:00+00:00"),
    sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("https://example.org/?q=151a3.xml"), "2026-09-27T09:41:00.5Z"), sitemapdoc.ref_with_lastmod(sitemapdoc.sitemap_ref("http://www.example.com/60#top9</..xml"), "")]),
    sitemapwrite.without_namespace(sitemapwrite.options()))),
    text)
    match sitemapread.read(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) =>
            test.assert_eq(list.len(doc.index.refs), 3)
            test.assert_eq(sitemapdoc.kind_name(doc.kind), "sitemapindex")
    match sitemapread.read_lenient(text)
        Err(f)  => test.fail(f.message())
        Ok(doc) => test.assert_eq(list.len(doc.skipped), 0)
