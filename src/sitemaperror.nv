// sitemaperror.nv — why a sitemap is refused, and whether the fault is
// in a file being read or in a document being written.
//
// The protocol's two limits are not faults.  Fifty thousand and one URLs
// is a document to split, not a broken one, and `sitemapdoc.check`
// answers a report about it.  The faults here are a file that cannot be
// read and a document that cannot be written.

// Why a sitemap could not be read or could not be written.
//
// ```novo
// use sitemaperror
//
// fn main() [io]
//     println(SitemapWrongRoot("rss").message())
// ```
pub enum SitemapFault
    // The text is not well-formed XML.  `at` is the byte offset the
    // parser stopped at and `why` is its own description.  A read
    // fault.
    SitemapNotXml(at: Int, why: Str)
    // The root element is neither `urlset` nor `sitemapindex`.
    // `found` is the element that was there, so a message can say what
    // the file actually is.  A read fault.
    SitemapWrongRoot(found: Str)
    // A `url` or a `sitemap` element has no `loc` child.  `loc` is the
    // one element the protocol requires, and an entry without one
    // names nothing.  A read fault.
    SitemapMissingLoc(entry_index: Int)
    // A `changefreq` element holds something that is not one of the
    // seven values the protocol defines.  `text` is what was written.
    // A read fault.
    SitemapBadChangefreq(text: Str)
    // A `priority` element is not a number between 0.0 and 1.0.
    // `text` is what was written.  A read fault.
    SitemapBadPriority(text: Str)
    // A `lastmod` element is not a W3C Datetime.  `text` is what was
    // written.  A read fault.
    SitemapBadLastmod(text: Str)
    // A `loc` is not an absolute URL, or is longer than the 2,048
    // characters the protocol allows.  `text` is what was written and
    // `why` says which.  The reader and the writer both raise it.
    SitemapBadLoc(text: Str, why: Str)
    // Text handed to the writer holds a character XML 1.0 section 2.2
    // does not admit.  `element` is the element it was for, `at` its
    // byte offset within that text, and `byte_value` its code point,
    // which for the usual case, a control character, is its byte.  A
    // write fault.
    SitemapUnwritable(element: Str, at: Int, byte_value: Int)

// `SitemapFault` is an `Error`, so a `Result` holding one is reported by
// anything that reports errors (SPEC section 3.4).
impl Error for SitemapFault
    // The one-line message, naming what was found and where.
    fn message(self) -> Str
        match self
            SitemapNotXml(a, w)        => "the sitemap is not well-formed XML at byte ${a}: ${w}"
            SitemapWrongRoot(f)        => "the root element is ${f}, not urlset or sitemapindex"
            SitemapMissingLoc(i)       => "entry ${i} has no loc"
            SitemapBadChangefreq(t)    => "'${t}' is not one of the seven changefreq values"
            SitemapBadPriority(t)      => "'${t}' is not a priority between 0.0 and 1.0"
            SitemapBadLastmod(t)       => "'${t}' is not a W3C Datetime"
            SitemapBadLoc(t, w)        => "the loc '${t}' ${w}"
            SitemapUnwritable(e, a, b) => "the ${e} holds character ${b} at byte ${a}, which XML 1.0 cannot carry"

// Whether this fault can only come from the writer.
//
// True for `SitemapUnwritable` alone.  `SitemapBadLoc` comes from both
// sides, and a caller of the writer knows that every fault it is
// handed is about the document it is writing.
//
// ```novo
// use sitemaperror
//
// fn main() [io]
//     let mine = SitemapUnwritable("loc", 4, 1)
//     println("${sitemaperror.is_writer_fault(mine)}")
// ```
pub fn is_writer_fault(f: SitemapFault) -> Bool []
    match f
        SitemapUnwritable(_, _, _) => true
        _                          => false

// A short stable code for a log or a metric label: `"not_xml"`,
// `"bad_priority"`, `"unwritable"`, and the rest.
//
// The code holds nothing the document carried, so it is safe as a
// metric label.
//
// ```novo
// use sitemaperror
//
// fn main() [io]
//     println(sitemaperror.code(SitemapWrongRoot("rss")))
// ```
pub fn code(f: SitemapFault) -> Str []
    match f
        SitemapNotXml(_, _)        => "not_xml"
        SitemapWrongRoot(_)        => "wrong_root"
        SitemapMissingLoc(_)       => "missing_loc"
        SitemapBadChangefreq(_)    => "bad_changefreq"
        SitemapBadPriority(_)      => "bad_priority"
        SitemapBadLastmod(_)       => "bad_lastmod"
        SitemapBadLoc(_, _)        => "bad_loc"
        SitemapUnwritable(_, _, _) => "unwritable"

// Whether a reader could carry on past this fault by dropping the one
// entry it is about.
//
// True for the faults about a single entry: a bad `changefreq`, a bad
// `priority`, a bad `lastmod`, and a missing or bad `loc`.  False for
// the faults about the document as a whole and for
// `SitemapUnwritable`.  `sitemapread.read_lenient` drops an entry for
// exactly these.
//
// ```novo
// use sitemaperror
//
// fn main() [io]
//     println("${sitemaperror.is_entry_fault(SitemapBadPriority("high"))}")
//     println("${sitemaperror.is_entry_fault(SitemapWrongRoot("rss"))}")
// ```
pub fn is_entry_fault(f: SitemapFault) -> Bool []
    match f
        SitemapMissingLoc(_)    => true
        SitemapBadChangefreq(_) => true
        SitemapBadPriority(_)   => true
        SitemapBadLastmod(_)    => true
        SitemapBadLoc(_, _)     => true
        _                       => false
