// sitemapurl.nv — one `url` element, with its three optional children
// typed.
//
// `priority` is carried as an integer count of thousandths: `500` is
// the default `0.5`.  The protocol writes it as a decimal between 0.0
// and 1.0, and a float read and written again can change its digits;
// thousandths are written with as few digits as represent them, so a
// priority survives a round trip.  No writer in the field uses a finer
// step.
//
// `lastmod` is a W3C Datetime, carried as the text it will be written
// as.  This package declares no effects and holds no calendar, so
// `is_datetime_shaped` checks the shape a reader parses and not whether
// the day exists.
//
// `changefreq` is an enum because the protocol names seven values and
// no others.  A reader meeting an eighth answers `SitemapBadChangefreq`
// naming what was written, so a site generator finds its own typo.

use std.str
use std.list

// How often the page at a URL is likely to change.
//
// The seven values of the protocol, and no others.  Every one of them
// is a hint: the protocol is explicit that a search engine may crawl
// on a different schedule, and `SitemapAlways` in particular is
// documented as being for pages that change every time they are
// accessed.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println(sitemapurl.changefreq_text(SitemapWeekly))
// ```
pub enum SitemapChangefreq
    // The element was not present.  Not the same as any of the seven:
    // absent means the site said nothing, and a writer must not invent
    // a value for it.
    SitemapUnstated
    // `always`: the page changes every time it is accessed.
    SitemapAlways
    // `hourly`.
    SitemapHourly
    // `daily`.
    SitemapDaily
    // `weekly`.
    SitemapWeekly
    // `monthly`.
    SitemapMonthly
    // `yearly`.
    SitemapYearly
    // `never`: an archived page.  The protocol notes that a crawler
    // may still revisit one.
    SitemapNever

// One `url` element.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println(sitemapurl.url("https://example.org/a").loc)
// ```
pub struct SitemapUrl
    // The `loc` element: an absolute URL, at most 2,048 characters.
    // The one child the protocol requires.
    loc: Str
    // The `lastmod` element, verbatim, or `""`.  A W3C Datetime, held
    // as the text it is written as.
    lastmod: Str
    // The `changefreq` element, or `SitemapUnstated`.
    changefreq: SitemapChangefreq
    // The `priority` element in thousandths: `500` is `0.5`.  `-1`
    // when the element was not present, which is not the same as `0`
    // — a priority of zero is a page the site is telling a crawler to
    // rank last, and an absent one means the default applies.
    priority_milli: Int

// A whole `urlset` document.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println("${list.len(sitemapurl.urlset([]).urls)}")
// ```
pub struct SitemapSet
    // The URLs, in the order the file gives them.
    urls: [SitemapUrl]

// A URL with nothing else set: no `lastmod`, no `changefreq`, no
// `priority`.
//
// The starting value every other builder narrows, and the one a site
// generator that has only a list of pages uses.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println("${sitemapurl.url("https://example.org/a").priority_milli}")
// ```
pub fn url(loc: Str) -> SitemapUrl []
    SitemapUrl { loc: loc, lastmod: "", changefreq: SitemapUnstated, priority_milli: -1 }

// The same URL with a `lastmod`.
//
// The text is written as it is given.  `is_datetime_shaped` is
// available for a caller that wants to check it first.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     let u = sitemapurl.with_lastmod(sitemapurl.url("https://example.org/a"), "2026-09-17")
//     println(u.lastmod)
// ```
pub fn with_lastmod(u: SitemapUrl, w3c_datetime: Str) -> SitemapUrl []
    SitemapUrl { loc: u.loc,
        lastmod: w3c_datetime,
        changefreq: u.changefreq,
        priority_milli: u.priority_milli }

// The same URL with a `changefreq`.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     let u = sitemapurl.with_changefreq(sitemapurl.url("https://example.org/a"), SitemapDaily)
//     println(sitemapurl.changefreq_text(u.changefreq))
// ```
pub fn with_changefreq(u: SitemapUrl, freq: SitemapChangefreq) -> SitemapUrl []
    SitemapUrl { loc: u.loc,
        lastmod: u.lastmod,
        changefreq: freq,
        priority_milli: u.priority_milli }

// The same URL with a `priority`, in thousandths.
//
// A value outside `0` to `1000` is clamped into it rather than
// refused, so a computed `1200` is written as `1.0`.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     let u = sitemapurl.with_priority(sitemapurl.url("https://example.org/a"), 800)
//     println("${u.priority_milli}")
// ```
pub fn with_priority(u: SitemapUrl, milli: Int) -> SitemapUrl []
    var p = milli
    if p < 0
        p = 0
    if p > 1000
        p = 1000
    SitemapUrl { loc: u.loc, lastmod: u.lastmod, changefreq: u.changefreq, priority_milli: p }

// A `urlset` from a list of URLs.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     let s = sitemapurl.urlset([sitemapurl.url("https://example.org/a")])
//     println("${list.len(s.urls)}")
// ```
pub fn urlset(urls: [SitemapUrl]) -> SitemapSet []
    SitemapSet { urls: urls[:] }

// The changefreq's text as the protocol writes it: `"weekly"`, and so
// on.  `SitemapUnstated` is `""`.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println(sitemapurl.changefreq_text(SitemapUnstated))
// ```
pub fn changefreq_text(freq: SitemapChangefreq) -> Str []
    match freq
        SitemapUnstated => ""
        SitemapAlways   => "always"
        SitemapHourly   => "hourly"
        SitemapDaily    => "daily"
        SitemapWeekly   => "weekly"
        SitemapMonthly  => "monthly"
        SitemapYearly   => "yearly"
        SitemapNever    => "never"

// The changefreq a text names, or `None`.
//
// `None` for any other text, the empty text included.  The protocol's
// values are lower case, and a value in another case is not one of
// them.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     match sitemapurl.changefreq_named("weekly")
//         Some(freq) => println(sitemapurl.changefreq_text(freq))
//         None       => println("not one of the seven")
// ```
pub fn changefreq_named(text: Str) -> ?SitemapChangefreq []
    list.find(seven(), f => changefreq_text(f) == text)

// A priority in thousandths as the `priority` element writes it:
// `500` is `"0.5"`, `1000` is `"1.0"`, `125` is `"0.125"`.
//
// As few digits as represent the value exactly, and one after the
// point at the least.  A value outside `0` to `1000`, such as the `-1`
// of an absent priority, is `""`.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println(sitemapurl.priority_text(500))
// ```
pub fn priority_text(milli: Int) -> Str []
    if milli < 0 or milli > 1000
        return ""
    var frac = str.pad_left("${milli % 1000}", 3, "0")
    while str.len(frac) > 1 and str.ends_with(frac, "0")
        frac = str.slice(frac, 0, str.len(frac) - 1)
    "${milli / 1000}.${frac}"

// A `priority` element's text as thousandths, or `None`.
//
// The text is an optional `0` or `1`, then an optional point and
// digits, with at least one digit: `0.8`, `1`, `.5` and `1.0` are
// priorities.  `None` for anything else and for a value above 1.0.
// Digits beyond a thousandth are truncated rather than rounded.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     match sitemapurl.priority_of("0.8")
//         Some(milli) => println("${milli}")
//         None        => println("not a priority")
// ```
pub fn priority_of(text: Str) -> ?Int []
    let point = str.index(text, ".") ?? str.len(text)
    let whole = str.slice(text, 0, point)
    var frac = ""
    if point < str.len(text)
        frac = str.slice(text, point + 1, str.len(text))
    if not (whole == "" or whole == "0" or whole == "1") or not digits_only(frac)
        return None
    if whole == "" and frac == ""
        return None
    let milli = str.to_int(str.pad_right(str.slice(frac, 0, 3), 3, "0")) ?? 0
    if whole == "1"
        if not zeros_only(frac)
            return None
        return Some(1000)
    Some(milli)

// Whether a `lastmod` has the shape of a W3C Datetime.
//
// The six forms of the W3C Datetime note the protocol names: `YYYY`,
// `YYYY-MM`, `YYYY-MM-DD`, and a complete date followed by `Thh:mm`,
// `Thh:mm:ss` or `Thh:mm:ss.s…` and a zone, `Z` or `+hh:mm` or
// `-hh:mm`.  Each number is checked against its range, and the day
// against 31, so `2026-02-30` is shaped and is not a day.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println("${sitemapurl.is_datetime_shaped("2026-09-17")}")
//     println("${sitemapurl.is_datetime_shaped("17 September 2026")}")
// ```
pub fn is_datetime_shaped(text: Str) -> Bool []
    let n = str.len(text)
    if n < 4 or not number_in(text, 0, 4, 0, 9999)
        return false
    if n == 4
        return true
    if not (at(text, 4) == '-' and number_in(text, 5, 2, 1, 12))
        return false
    if n == 7
        return true
    if not (at(text, 7) == '-' and number_in(text, 8, 2, 1, 31))
        return false
    if n == 10
        return true
    if not (at(text, 10) == 'T' and number_in(text, 11, 2, 0, 23) and at(text, 13) == ':'
            and number_in(text, 14, 2, 0, 59))
        return false
    var i = 16
    if at(text, i) == ':'
        if not number_in(text, 17, 2, 0, 59)
            return false
        i = 19
        if at(text, i) == '.'
            i = i + 1
            let start = i
            while is_digit(at(text, i))
                i = i + 1
            if i == start
                return false
    zone_at(text, i)

// Why a `loc` is not acceptable, or `""` when it is.
//
// The protocol requires an absolute URL, a scheme and a host, of at
// most 2,048 characters, counted here in bytes.  The answer says which
// rule the text breaks.  The protocol's rule that every URL begin with
// the sitemap file's own path is `sitemapdoc.check_prefix`, because it
// needs the file's address.
//
// ```novo
// use sitemapurl
//
// fn main() [io]
//     println(sitemapurl.loc_problem("https://example.org/a"))
//     println(sitemapurl.loc_problem("/a"))
// ```
pub fn loc_problem(loc: Str) -> Str []
    if loc == ""
        return "is empty"
    if str.len(loc) > 2048
        return "is longer than 2,048 characters"
    let sep = str.index(loc, "://") ?? -1
    if sep <= 0 or not is_scheme(str.slice(loc, 0, sep))
        return "is not an absolute URL"
    let rest = str.slice(loc, sep + 3, str.len(loc))
    var host_end = str.len(rest)
    for mark in ["/", "?", "#"]
        let i = str.index(rest, mark) ?? host_end
        if i < host_end
            host_end = i
    if host_end == 0
        return "has no host"
    ""

// The seven values, in the protocol's order.
fn seven() -> [SitemapChangefreq]
    [SitemapAlways,
        SitemapHourly,
        SitemapDaily,
        SitemapWeekly,
        SitemapMonthly,
        SitemapYearly,
        SitemapNever]

// Whether a text holds nothing but ASCII digits.
fn digits_only(t: Str) -> Bool
    for i in 0..str.len(t)
        if not is_digit(at(t, i))
            return false
    true

// Whether a text holds nothing but the digit zero.
fn zeros_only(t: Str) -> Bool
    for i in 0..str.len(t)
        if at(t, i) != '0'
            return false
    true

// Whether the `width` digits at `from` are a number from `low` to
// `high`.
fn number_in(t: Str, from: Int, width: Int, low: Int, high: Int) -> Bool
    let part = str.slice(t, from, from + width)
    if str.len(part) != width or not digits_only(part)
        return false
    let n = str.to_int(part) ?? -1
    n >= low and n <= high

// Whether a W3C Datetime zone starts at `i` and ends the text.
fn zone_at(t: Str, i: Int) -> Bool
    let rest = str.slice(t, i, str.len(t))
    if rest == "Z"
        return true
    if str.len(rest) != 6 or not (at(rest, 0) == '+' or at(rest, 0) == '-') or at(rest, 3) != ':'
        return false
    number_in(rest, 1, 2, 0, 23) and number_in(rest, 4, 2, 0, 59)

// Whether a text is a URL scheme: a letter, then letters, digits, `+`,
// `-` and `.`.
fn is_scheme(t: Str) -> Bool
    if not is_letter(at(t, 0))
        return false
    for i in 1..str.len(t)
        let b = at(t, i)
        if not (is_letter(b) or is_digit(b) or b == '+' or b == '-' or b == '.')
            return false
    true

// The byte at `i`, or -1 past the end.
fn at(t: Str, i: Int) -> Int
    str.byte_at_or(t, i, -1)

fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

fn is_letter(b: Int) -> Bool
    b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z'
