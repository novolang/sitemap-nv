// The kind's name as the root element spells it: `"urlset"` or
// `"sitemapindex"`.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.kind_name(SitemapIndexKind))
// ```
pub fn kind_name(k: SitemapKind) -> Str []
    todo("sitemap-nv.sitemapdoc.kind_name")

// Every URL in a set that does not sit under the same path prefix as
// the sitemap file itself.
//
// The protocol's cross-submission rule: a sitemap at
// `https://example.org/shop/sitemap.xml` may name URLs under
// `https://example.org/shop/` and no others, and a search engine
// ignores the ones that break it.  This is the check that finds them
// before they are published, and it takes the file's own address
// because nothing here knows where the file will go.
//
// The answer is the offending URLs, so a message can name them.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let s = sitemapurl.urlset([sitemapurl.url("https://example.org/a")])
//     println("${list.len(sitemapdoc.check_prefix(s, "https://example.org/sitemap.xml"))}")
// ```
pub fn check_prefix(s: sitemapurl.SitemapSet, sitemap_loc: Str) -> [Str] []
    todo("sitemap-nv.sitemapdoc.check_prefix")

// The namespace every sitemap document declares:
// `http://www.sitemaps.org/schemas/sitemap/0.9`.
//
// The writer emits it and the reader accepts a document with it, with
// another, or with none — see the README's rules.  It is public
// because a caller assembling a document with elements from an
// extension needs the base namespace beside theirs.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.namespace())
// ```
pub fn namespace() -> Str []
    todo("sitemap-nv.sitemapdoc.namespace")
