// sitemapdoc.nv — the index form, and the protocol's two limits as a
// report.
//
// The protocol caps one file at 50,000 URLs and 50 MB uncompressed.  A
// site with more pages than that has a sitemap to split into several
// files named from an index, not a broken sitemap, so `check` answers a
// `SitemapReport`: how far over the document is and how many files it
// takes.
//
// The 50 MB limit is on the written file, and its size depends on how
// it is written.  `check` measures the document as
// `sitemapwrite.options()` writes it, and `sitemapwrite.byte_length`
// measures it under any other options.
//
// A `sitemapindex` names other sitemap files by their `loc`.  Nothing in
// this package fetches one.

use std.str
use std.list
use sitemapurl
use sitemapwrite

// One entry in a `sitemapindex`: another sitemap file.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.sitemap_ref("https://example.org/sitemap-1.xml").loc)
// ```
pub struct SitemapRef
    // The `loc` element: the absolute URL of another sitemap file.
    loc: Str
    // The `lastmod` element, verbatim, or `""`.
    lastmod: Str

// A whole `sitemapindex` document.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${list.len(sitemapdoc.index([]).refs)}")
// ```
pub struct SitemapIndex
    // The sitemap files this index names, in order.
    refs: [SitemapRef]

// Which of the two documents a file is.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.kind_name(SitemapUrlsetKind))
// ```
pub enum SitemapKind
    // A `urlset`: a list of pages.
    SitemapUrlsetKind
    // A `sitemapindex`: a list of other sitemap files.
    SitemapIndexKind

// The two caps the protocol sets on one file.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${sitemapdoc.limits().max_entries}")
// ```
pub struct SitemapLimits
    // How many `url` or `sitemap` elements one file may hold: 50,000.
    max_entries: Int
    // How many bytes the uncompressed file may be: 52,428,800, which
    // is 50 MB counted as 1,048,576 bytes to the megabyte.
    max_bytes: Int

// What a document measures against the limits.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let report = sitemapdoc.check(sitemapurl.urlset([]), sitemapdoc.limits())
//     println("${report.entries}")
// ```
pub struct SitemapReport
    // How many entries the document holds.
    entries: Int
    // How many bytes the document takes written with
    // `sitemapwrite.options()`.
    bytes: Int
    // Whether the entry count is over the limit.
    over_entries: Bool
    // Whether that size is over the limit.
    over_bytes: Bool
    // How many files this document would have to be split into to
    // conform.  `1` when it already does.
    files_needed: Int

// The protocol's limits: 50,000 entries and 52,428,800 bytes.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${sitemapdoc.limits().max_bytes}")
// ```
pub fn limits() -> SitemapLimits []
    SitemapLimits { max_entries: 50000, max_bytes: 52428800 }

// Limits of a caller's own.
//
// The protocol's numbers are a maximum, and a caller may choose less.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${sitemapdoc.limits_of(10000, 5242880).max_entries}")
// ```
pub fn limits_of(max_entries: Int, max_bytes: Int) -> SitemapLimits []
    SitemapLimits { max_entries: max_entries, max_bytes: max_bytes }

// How a URL set measures against the limits.
//
// The size is what the document takes written with
// `sitemapwrite.options()`, and `files_needed` is how many files
// `split` makes of it.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let report = sitemapdoc.check(sitemapurl.urlset([]), sitemapdoc.limits())
//     println("${report.files_needed}")
// ```
pub fn check(s: SitemapSet, l: SitemapLimits) -> SitemapReport []
    let entries = list.len(s.urls)
    let size = sitemapwrite.byte_length(s, sitemapwrite.options())
    SitemapReport { entries: entries,
        bytes: size,
        over_entries: entries > l.max_entries,
        over_bytes: size > l.max_bytes,
        files_needed: list.len(split(s, l)) }

// How an index measures against the limits.
//
// An index is capped the same way a URL set is.  An index may not name
// another index, so a `files_needed` above one here means the sitemaps
// have to be larger rather than more numerous.  The size is what the
// index takes written with `sitemapwrite.options()`.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${sitemapdoc.check_index(sitemapdoc.index([]), sitemapdoc.limits()).entries}")
// ```
pub fn check_index(i: SitemapIndex, l: SitemapLimits) -> SitemapReport []
    let entries = list.len(i.refs)
    let size = sitemapwrite.index_byte_length(i, sitemapwrite.options())
    SitemapReport { entries: entries,
        bytes: size,
        over_entries: entries > l.max_entries,
        over_bytes: size > l.max_bytes,
        files_needed: max(ceil_div(entries, l.max_entries), ceil_div(size, l.max_bytes)) }

// Whether a document conforms: neither limit exceeded.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let report = sitemapdoc.check(sitemapurl.urlset([]), sitemapdoc.limits())
//     println("${sitemapdoc.conforms(report)}")
// ```
pub fn conforms(report: SitemapReport) -> Bool []
    not report.over_entries and not report.over_bytes

// A URL set split into as many conforming files as it takes.
//
// The order of the URLs is kept, and each file holds as many as fit
// under both limits, measured as `sitemapwrite.options()` writes them.
// A set that already conforms answers a list of one, the empty set
// included.  A URL too large for a file on its own gets a file to
// itself.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let parts = sitemapdoc.split(sitemapurl.urlset([]), sitemapdoc.limits())
//     println("${list.len(parts)}")
// ```
pub fn split(s: SitemapSet, l: SitemapLimits) -> [SitemapSet] []
    let o = sitemapwrite.options()
    let frame = sitemapwrite.byte_length(sitemapurl.urlset([]), o)
    var parts: [SitemapSet] = []
    var current: [SitemapUrl] = []
    var size = frame
    for u in s.urls
        let n = sitemapwrite.url_byte_length(u, o)
        if list.len(current) > 0 and (list.len(current) >= l.max_entries or size + n > l.max_bytes)
            list.push(parts, sitemapurl.urlset(current))
            current = []
            size = frame
        list.push(current, u)
        size = size + n
    list.push(parts, sitemapurl.urlset(current))
    parts

// An index naming a list of sitemap files.
//
// `locs` are the addresses the files will be published at, in the order
// `split` made them.  The caller supplies them, because this package
// does not know where anything is published.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     let i = sitemapdoc.index_for(["https://example.org/sitemap-1.xml"])
//     println("${list.len(i.refs)}")
// ```
pub fn index_for(locs: [Str]) -> SitemapIndex []
    SitemapIndex { refs: list.map(locs, sitemap_ref) }

// One index entry.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.sitemap_ref("https://example.org/sitemap-1.xml").lastmod)
// ```
pub fn sitemap_ref(loc: Str) -> SitemapRef []
    SitemapRef { loc: loc, lastmod: "" }

// The same entry with a `lastmod`.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     let r = sitemapdoc.ref_with_lastmod(
//                 sitemapdoc.sitemap_ref("https://example.org/sitemap-1.xml"), "2026-09-17")
//     println(r.lastmod)
// ```
pub fn ref_with_lastmod(r: SitemapRef, w3c_datetime: Str) -> SitemapRef []
    SitemapRef { loc: r.loc, lastmod: w3c_datetime }

// An index from a list of entries.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println("${list.len(sitemapdoc.index([]).refs)}")
// ```
pub fn index(refs: [SitemapRef]) -> SitemapIndex []
    SitemapIndex { refs: refs[:] }

// The kind's name as the root element spells it: `"urlset"` or
// `"sitemapindex"`.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.kind_name(SitemapIndexKind))
// ```
pub fn kind_name(k: SitemapKind) -> Str []
    match k
        SitemapUrlsetKind => "urlset"
        SitemapIndexKind  => "sitemapindex"

// Every URL in a set that does not sit under the same path prefix as
// the sitemap file itself.
//
// The protocol's rule: a sitemap at
// `https://example.org/shop/sitemap.xml` may name URLs under
// `https://example.org/shop/` and no others, and a search engine
// ignores the ones that break it.  The prefix is the file's address up
// to and including its last `/`.  The answer is the offending URLs, in
// order.
//
// ```novo
// use sitemapdoc
// use sitemapurl
//
// fn main() [io]
//     let s = sitemapurl.urlset([sitemapurl.url("https://example.org/a")])
//     println("${list.len(sitemapdoc.check_prefix(s, "https://example.org/sitemap.xml"))}")
// ```
pub fn check_prefix(s: SitemapSet, sitemap_loc: Str) -> [Str] []
    let cut = last_slash(sitemap_loc) + 1
    let prefix = str.slice(sitemap_loc, 0, cut)
    s.urls |> list.filter(u => not str.starts_with(u.loc, prefix)) |> list.map(loc_of)

// The namespace every sitemap document declares:
// `http://www.sitemaps.org/schemas/sitemap/0.9`.
//
// The writer declares it, and the reader accepts a document with it,
// with another, or with none.
//
// ```novo
// use sitemapdoc
//
// fn main() [io]
//     println(sitemapdoc.namespace())
// ```
pub fn namespace() -> Str []
    "http://www.sitemaps.org/schemas/sitemap/0.9"

// A URL's `loc`.
fn loc_of(u: SitemapUrl) -> Str
    u.loc

// The index of the last `/` in a text, or -1.
fn last_slash(t: Str) -> Int
    var found = -1
    for i in 0..str.len(t)
        if str.byte_at_or(t, i, 0) == '/'
            found = i
    found

// `a / b` rounded up, for a positive `b`.
fn ceil_div(a: Int, b: Int) -> Int
    (a + b - 1) / b

fn max(a: Int, b: Int) -> Int
    if a > b
        return a
    b
