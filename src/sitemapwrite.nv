// sitemapwrite.nv — the document, appended to a buffer the caller owns.
//
// Every writing function takes the buffer to write into and answers it
// with the document appended.  Nothing opens a file, so a site
// generator writes the bytes where it has decided they go and reuses
// one buffer for several split files.
//
// Text is escaped as the protocol's entity table requires: `&`, `'`,
// `"`, `>` and `<` become `&amp;`, `&apos;`, `&quot;`, `&gt;` and
// `&lt;`.  A URL with a query string has an ampersand in it, and an
// unescaped one is a file no parser reads.  A character XML 1.0
// section 2.2 does not admit is refused with its offset, as xml-nv's
// `is_xml_char` decides it, and nothing is appended.
//
// An element whose value was never set is not written.  An absent
// `changefreq` is `SitemapUnstated` and an absent `priority` is `-1`,
// and neither is written as a default.
//
// The layout is one element per line, each nested element indented by
// `indent` spaces, with a line feed after every line.  With an indent
// of `0` the document is one line with no line feed.

use std.str
use std.list
use xmlparse
use sitemapurl

// How a document is laid out.
//
// ```novo
// use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.options().indent}")
// ```
pub @value
struct SitemapWriteOptions
    // Spaces per level of nesting, or `0` for one line.  White space
    // between elements means nothing to a reader, and indenting fifty
    // thousand URLs costs several megabytes of the limit.
    indent: Int
    // Whether to write the `<?xml version="1.0" encoding="UTF-8"?>`
    // declaration first.  The protocol requires UTF-8, and the
    // declaration says so.
    declaration: Bool
    // Whether to declare the sitemaps.org 0.9 namespace on the root
    // element.  Off only for a document embedded in another that
    // declares it.
    namespace: Bool

// The defaults: a two-space indent, a declaration, and the namespace.
//
// ```novo
// use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.options().declaration}")
// ```
pub fn options() -> SitemapWriteOptions []
    SitemapWriteOptions { indent: 2, declaration: true, namespace: true }

// The smallest file that says the same thing: no indent, no
// declaration.
//
// The namespace is still declared.
//
// ```novo
// use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.compact().indent}")
// ```
pub fn compact() -> SitemapWriteOptions []
    SitemapWriteOptions { indent: 0, declaration: false, namespace: true }

// The same options without the namespace declaration.
//
// ```novo
// use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.without_namespace(sitemapwrite.options()).namespace}")
// ```
pub fn without_namespace(o: SitemapWriteOptions) -> SitemapWriteOptions []
    SitemapWriteOptions { indent: o.indent, declaration: o.declaration, namespace: false }

// A `urlset` document, appended to `out`.
//
// The answer is a fault when any text in it holds a character XML
// cannot carry or a `loc` is not an absolute URL, and nothing is
// appended then.  The limits are not checked here; `sitemapdoc.check`
// measures them, and a document over them is written as asked.
//
// ```novo
// use sitemapurl
// use sitemapwrite
//
// fn main() [io]
//     match sitemapwrite.write_urlset([], sitemapurl.urlset([]), sitemapwrite.options())
//         Ok(bytes)  => println("${list.len(bytes)} byte(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn write_urlset(var out: [u8], s: SitemapSet,
                    o: SitemapWriteOptions) -> Result<[u8], SitemapFault> []
    let text = to_str(s, o)!
    Ok(appended(out, text))

// A `sitemapindex` document, appended to `out`, refused as
// `write_urlset` refuses.
//
// ```novo
// // use sitemapwrite
//
// fn main() [io]
//     match sitemapwrite.write_index([], sitemapdoc.index([]), sitemapwrite.options())
//         Ok(bytes)  => println("${list.len(bytes)} byte(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn write_index(var out: [u8], i: SitemapIndex,
                   o: SitemapWriteOptions) -> Result<[u8], SitemapFault> []
    for r in i.refs
        if let Some(f) = ref_fault(r)
            return Err(f)
    Ok(appended(out, index_text(i, o)))

// One `url` element, appended to `out`.
//
// For a caller streaming a large sitemap, which writes the root element
// itself with `write_open` and `write_close`.
//
// ```novo
// use sitemapurl
// use sitemapwrite
//
// fn main() [io]
//     let u = sitemapurl.url("https://example.org/a")
//     match sitemapwrite.write_url([], u, sitemapwrite.options())
//         Ok(bytes)  => println("${list.len(bytes)} byte(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn write_url(var out: [u8], u: SitemapUrl,
                 o: SitemapWriteOptions) -> Result<[u8], SitemapFault> []
    if let Some(f) = url_fault(u)
        return Err(f)
    Ok(appended(out, url_text(u, o)))

// The declaration, when the options ask for one, and the root
// element's open tag.
//
// ```novo
// // use sitemapwrite
//
// fn main() [io]
//     println("${list.len(sitemapwrite.write_open([], SitemapUrlsetKind, sitemapwrite.options()))}")
// ```
pub fn write_open(var out: [u8], kind: SitemapKind, o: SitemapWriteOptions) -> [u8] []
    appended(out, open_text(kind, o))

// The root element's close tag.
//
// ```novo
// // use sitemapwrite
//
// fn main() [io]
//     println("${list.len(sitemapwrite.write_close([], SitemapUrlsetKind, sitemapwrite.options()))}")
// ```
pub fn write_close(var out: [u8], kind: SitemapKind, o: SitemapWriteOptions) -> [u8] []
    appended(out, line(0, "</${root_name(kind)}>", o))

// A `urlset` as a string.
//
// The same document `write_urlset` appends, refused the same way.
//
// ```novo
// use sitemapurl
// use sitemapwrite
//
// fn main() [io]
//     match sitemapwrite.to_str(sitemapurl.urlset([]), sitemapwrite.options())
//         Ok(text)   => println("${str.len(text)} character(s)")
//         Err(fault) => println(fault.message())
// ```
pub fn to_str(s: SitemapSet, o: SitemapWriteOptions) -> Result<Str, SitemapFault> []
    for u in s.urls
        if let Some(f) = url_fault(u)
            return Err(f)
    var parts: [Str] = [open_text(SitemapUrlsetKind, o)]
    for u in s.urls
        list.push(parts, url_text(u, o))
    list.push(parts, line(0, "</urlset>", o))
    Ok(str.join(parts, ""))

// How many bytes a URL set would take, written with these options.
//
// Measured one URL at a time, without building the whole document, and
// equal to the length of what `to_str` writes for a set it accepts.
//
// ```novo
// use sitemapurl
// use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.byte_length(sitemapurl.urlset([]), sitemapwrite.options())}")
// ```
pub fn byte_length(s: SitemapSet, o: SitemapWriteOptions) -> Int []
    var n = str.len(open_text(SitemapUrlsetKind, o)) + str.len(line(0, "</urlset>", o))
    for u in s.urls
        n = n + url_byte_length(u, o)
    n

// How many bytes one `url` element would take.
//
// The per-entry part of `byte_length`, for a caller filling a file one
// URL at a time.
//
// ```novo
// use sitemapurl
// use sitemapwrite
//
// fn main() [io]
//     let u = sitemapurl.url("https://example.org/a")
//     println("${sitemapwrite.url_byte_length(u, sitemapwrite.options())}")
// ```
pub fn url_byte_length(u: SitemapUrl, o: SitemapWriteOptions) -> Int []
    str.len(url_text(u, o))

// How many bytes an index takes written with these options.
//
// What `sitemapdoc.check_index` measures an index by.
//
// ```novo
// // use sitemapwrite
//
// fn main() [io]
//     println("${sitemapwrite.index_byte_length(sitemapdoc.index([]), sitemapwrite.compact())}")
// ```
pub fn index_byte_length(i: SitemapIndex, o: SitemapWriteOptions) -> Int []
    str.len(index_text(i, o))

// A whole index as text.
fn index_text(i: SitemapIndex, o: SitemapWriteOptions) -> Str
    var parts: [Str] = [open_text(SitemapIndexKind, o)]
    for r in i.refs
        list.push(parts, line(1, "<sitemap>", o))
        list.push(parts, line(2, "<loc>${escaped(r.loc)}</loc>", o))
        if r.lastmod != ""
            list.push(parts, line(2, "<lastmod>${escaped(r.lastmod)}</lastmod>", o))
        list.push(parts, line(1, "</sitemap>", o))
    list.push(parts, line(0, "</sitemapindex>", o))
    str.join(parts, "")

// One `url` element as text.
fn url_text(u: SitemapUrl, o: SitemapWriteOptions) -> Str
    var parts: [Str] = [line(1, "<url>", o), line(2, "<loc>${escaped(u.loc)}</loc>", o)]
    if u.lastmod != ""
        list.push(parts, line(2, "<lastmod>${escaped(u.lastmod)}</lastmod>", o))
    let freq = sitemapurl.changefreq_text(u.changefreq)
    if freq != ""
        list.push(parts, line(2, "<changefreq>${freq}</changefreq>", o))
    let priority = sitemapurl.priority_text(u.priority_milli)
    if priority != ""
        list.push(parts, line(2, "<priority>${priority}</priority>", o))
    list.push(parts, line(1, "</url>", o))
    str.join(parts, "")

// The declaration and the root's open tag.
fn open_text(kind: SitemapKind, o: SitemapWriteOptions) -> Str
    var head = ""
    if o.declaration
        head = line(0, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>", o)
    var ns = ""
    if o.namespace
        ns = " xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\""
    head + line(0, "<${root_name(kind)}${ns}>", o)

// One line at a nesting level: indented and ended with a line feed, or
// as it is when the indent is `0`.
fn line(level: Int, text: Str, o: SitemapWriteOptions) -> Str
    if o.indent == 0
        return text
    str.repeat(" ", level * o.indent) + text + "\n"

// Text with the protocol's five entities escaped.
fn escaped(t: Str) -> Str
    let amp = str.replace_all(t, "&", "&amp;")
    let quotes = str.replace_all(str.replace_all(amp, "'", "&apos;"), "\"", "&quot;")
    str.replace_all(str.replace_all(quotes, ">", "&gt;"), "<", "&lt;")

// The fault a URL would be written with, or `None`.
fn url_fault(u: SitemapUrl) -> ?SitemapFault
    let why = sitemapurl.loc_problem(u.loc)
    if why != ""
        return Some(SitemapBadLoc(u.loc, why))
    char_fault("loc", u.loc) ?? char_fault("lastmod", u.lastmod)

// The fault an index entry would be written with, or `None`.
fn ref_fault(r: SitemapRef) -> ?SitemapFault
    let why = sitemapurl.loc_problem(r.loc)
    if why != ""
        return Some(SitemapBadLoc(r.loc, why))
    char_fault("loc", r.loc) ?? char_fault("lastmod", r.lastmod)

// `SitemapUnwritable` for the first character of `t` that XML 1.0
// cannot carry, or `None`.
fn char_fault(element: Str, t: Str) -> ?SitemapFault
    for i in 0..str.len(t)
        let cp = code_point_at(t, i)
        if cp >= 0 and not xmlparse.is_xml_char(cp)
            return Some(SitemapUnwritable(element, i, cp))
    None

// The code point whose UTF-8 encoding starts at byte `i`, or -1 for a
// continuation byte.
fn code_point_at(t: Str, i: Int) -> Int
    let b = str.byte_at_or(t, i, 0)
    if b < 128
        return b
    if b < 192
        return -1
    if b < 224
        return ((b & 31) << 6) | cont(t, i + 1)
    if b < 240
        return ((b & 15) << 12) | (cont(t, i + 1) << 6) | cont(t, i + 2)
    ((b & 7) << 18) | (cont(t, i + 1) << 12) | (cont(t, i + 2) << 6) | cont(t, i + 3)

// The six payload bits of a UTF-8 continuation byte.
fn cont(t: Str, i: Int) -> Int
    str.byte_at_or(t, i, 0) & 63

// `out` with the bytes of `text` after what it held.
fn appended(var out: [u8], text: Str) -> [u8]
    for i in 0..str.len(text)
        list.push(out, str.byte_at_or(text, i, 0) as u8)
    out

// The root element's name for a kind of document.
fn root_name(kind: SitemapKind) -> Str
    match kind
        SitemapUrlsetKind => "urlset"
        SitemapIndexKind  => "sitemapindex"
